{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "read",
        "refresh"
      ]
    },
    "urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1,
      "maxItems": 10,
      "description": "Public page URLs to read (1–10); no login or custom headers."
    },
    "maxCharacters": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 50000,
      "description": "Maximum text characters per page; default 10000."
    }
  },
  "required": [
    "action",
    "urls"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
