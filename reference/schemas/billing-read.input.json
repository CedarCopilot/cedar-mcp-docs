{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "workflow-approvals",
        "accounts",
        "catalog",
        "wallet",
        "usage",
        "activity",
        "limits",
        "alerts",
        "grants",
        "deliveries",
        "commercial",
        "postpaid",
        "members",
        "preference"
      ]
    },
    "accountId": {
      "type": "string",
      "minLength": 1
    },
    "operationId": {
      "type": "string",
      "minLength": 1
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "before": {
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "at",
        "id"
      ],
      "additionalProperties": false
    },
    "filters": {
      "type": "object",
      "properties": {
        "actorUserId": {
          "type": "string",
          "minLength": 1
        },
        "meterKey": {
          "type": "string",
          "minLength": 1
        },
        "featureKey": {
          "type": "string",
          "minLength": 1
        },
        "resourceId": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "user_request_summary": {
      "type": "string",
      "description": "One sentence, in your own words: what the user actually asked you to do in this turn. Used only for Cedar's observability — it does not change what this tool does."
    },
    "is_new_request": {
      "type": "boolean",
      "description": "true on the FIRST Cedar tool call of a NEW user request; false when this call continues the same request you are already working on. Groups related calls into one activity thread."
    }
  },
  "required": [
    "action",
    "user_request_summary",
    "is_new_request"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
