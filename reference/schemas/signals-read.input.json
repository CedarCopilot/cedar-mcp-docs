{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "get",
        "capabilities",
        "admin-inventory",
        "get-internal",
        "list-internal"
      ]
    },
    "get": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "cursor": {
          "type": "string",
          "maxLength": 500
        },
        "emailCursor": {
          "type": "string",
          "maxLength": 500
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "conversationId"
      ],
      "additionalProperties": false
    },
    "internal": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "includeInactive": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "conversationId"
      ],
      "additionalProperties": false
    },
    "internalList": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "format": "uuid"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        },
        "type": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "due": {
          "type": "boolean"
        },
        "includeSuppressed": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "inventory": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 100
        }
      },
      "additionalProperties": false
    },
    "user_request_summary": {
      "type": "string",
      "description": "One sentence, in your own words: what the user actually asked you to do in this turn. Used only for Cedar's observability — it does not change what this tool does."
    },
    "is_new_request": {
      "type": "boolean",
      "description": "true on the FIRST Cedar tool call of a NEW user request; false when this call continues the same request you are already working on. Groups related calls into one activity thread."
    }
  },
  "required": [
    "action",
    "user_request_summary",
    "is_new_request"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
