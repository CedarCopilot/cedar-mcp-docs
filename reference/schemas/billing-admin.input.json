{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "inventory",
        "preview-import",
        "verify-import",
        "reconcile-subscription",
        "save-offer",
        "save-catalog",
        "save-allowance",
        "payment-events",
        "retry-payment",
        "process-postpaid",
        "postpaid",
        "configure-postpaid",
        "correct-usage",
        "organization-monthly-limits",
        "organization-accounts",
        "provision-organization-accounts"
      ]
    },
    "apply": {
      "type": "boolean"
    },
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "customerId": {
      "$ref": "#/properties/accountId"
    },
    "cursor": {
      "$ref": "#/properties/accountId"
    },
    "subscriptionId": {
      "$ref": "#/properties/accountId"
    },
    "bindingId": {
      "$ref": "#/properties/accountId"
    },
    "snapshotHash": {
      "$ref": "#/properties/accountId"
    },
    "ownershipReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "offer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "type": {
          "type": "string",
          "enum": [
            "topup",
            "subscription"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "externalPriceId": {
          "type": "string",
          "pattern": "^price_[A-Za-z0-9]+$"
        },
        "grantMicrocredits": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,29})$"
        },
        "money": {
          "type": "object",
          "properties": {
            "minorUnits": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,11}$"
            },
            "currency": {
              "type": "string",
              "pattern": "^[a-z]{3}$"
            }
          },
          "required": [
            "minorUnits",
            "currency"
          ],
          "additionalProperties": false
        },
        "grantExpiry": {
          "type": "string",
          "enum": [
            "never",
            "paid_period_end"
          ]
        },
        "active": {
          "type": "boolean",
          "default": false
        },
        "termsVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "terms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "approvalReference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "version",
        "type",
        "label",
        "externalPriceId",
        "grantMicrocredits",
        "money",
        "grantExpiry",
        "termsVersion",
        "terms"
      ],
      "additionalProperties": false
    },
    "catalog": {
      "type": "object",
      "properties": {
        "meters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "version": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "featureKey": {
                "$ref": "#/properties/catalog/properties/meters/items/properties/key"
              },
              "producerKey": {
                "$ref": "#/properties/catalog/properties/meters/items/properties/key"
              },
              "unit": {
                "$ref": "#/properties/catalog/properties/meters/items/properties/key"
              },
              "dimensionKeys": {
                "type": "array",
                "items": {
                  "$ref": "#/properties/catalog/properties/meters/items/properties/key"
                }
              },
              "quantityScale": {
                "type": "integer",
                "minimum": 0,
                "maximum": 12
              },
              "chargingMode": {
                "type": "string",
                "enum": [
                  "disabled",
                  "shadow",
                  "billable"
                ]
              },
              "displayName": {
                "$ref": "#/properties/catalog/properties/meters/items/properties/key"
              }
            },
            "required": [
              "key",
              "version",
              "featureKey",
              "producerKey",
              "unit",
              "dimensionKeys",
              "quantityScale",
              "chargingMode",
              "displayName"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "rates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/properties/catalog/properties/meters/items/properties/key"
              },
              "version": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "meterKey": {
                "$ref": "#/properties/catalog/properties/meters/items/properties/key"
              },
              "meterVersion": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "matchDimensions": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "microcreditsPerUnit": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,12})?$"
              },
              "effectiveFrom": {
                "type": "string",
                "format": "date-time"
              },
              "effectiveUntil": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "billableOutcome": {
                "type": "string",
                "enum": [
                  "success_only",
                  "consumed_units"
                ]
              },
              "cachePolicy": {
                "type": "string",
                "const": "free"
              },
              "customerDescription": {
                "$ref": "#/properties/catalog/properties/meters/items/properties/key"
              }
            },
            "required": [
              "id",
              "version",
              "meterKey",
              "meterVersion",
              "matchDimensions",
              "microcreditsPerUnit",
              "effectiveFrom",
              "effectiveUntil",
              "billableOutcome",
              "cachePolicy",
              "customerDescription"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        }
      },
      "required": [
        "meters",
        "rates"
      ],
      "additionalProperties": false
    },
    "allowance": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/properties/catalog/properties/meters/items/properties/key"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "subscriptionBindingId": {
          "$ref": "#/properties/catalog/properties/meters/items/properties/key"
        },
        "creditsPerPaidPeriod": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,29})$"
        },
        "quantityBasis": {
          "type": "string",
          "enum": [
            "subscription",
            "paid_seat"
          ]
        },
        "eligibleSubscriptionItemIds": {
          "type": "array",
          "items": {
            "$ref": "#/properties/catalog/properties/meters/items/properties/key"
          },
          "minItems": 1
        },
        "allowedMeters": {
          "type": "array",
          "items": {
            "$ref": "#/properties/catalog/properties/meters/items/properties/key"
          },
          "minItems": 1
        },
        "expiresAtPeriodEnd": {
          "type": "boolean",
          "const": true
        },
        "effectiveFrom": {
          "type": "string",
          "format": "date-time"
        },
        "effectiveUntil": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "version",
        "subscriptionBindingId",
        "creditsPerPaidPeriod",
        "quantityBasis",
        "eligibleSubscriptionItemIds",
        "allowedMeters",
        "expiresAtPeriodEnd",
        "effectiveFrom",
        "effectiveUntil"
      ],
      "additionalProperties": false
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "before": {
      "type": "string",
      "format": "date-time"
    },
    "inboxId": {
      "$ref": "#/properties/accountId"
    },
    "batchId": {
      "$ref": "#/properties/accountId"
    },
    "correction": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "usageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "refundMicrocredits": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,29}$"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "reviewReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "accountId",
        "usageId",
        "refundMicrocredits",
        "idempotencyKey",
        "reason",
        "reviewReference"
      ],
      "additionalProperties": false
    },
    "postpaid": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0
        },
        "subscriptionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rolloutReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 450
        }
      },
      "required": [
        "accountId",
        "enabled",
        "expectedVersion",
        "rolloutReference"
      ],
      "additionalProperties": false
    },
    "reviewReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "idempotencyKey": {
      "$ref": "#/properties/accountId"
    },
    "organizationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "user_request_summary": {
      "type": "string",
      "description": "One sentence, in your own words: what the user actually asked you to do in this turn. Used only for Cedar's observability — it does not change what this tool does."
    },
    "is_new_request": {
      "type": "boolean",
      "description": "true on the FIRST Cedar tool call of a NEW user request; false when this call continues the same request you are already working on. Groups related calls into one activity thread."
    }
  },
  "required": [
    "action",
    "user_request_summary",
    "is_new_request"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
