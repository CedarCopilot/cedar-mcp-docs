{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update-fields",
        "create-event",
        "mutate",
        "reassign-ownership",
        "link-external-crm-deal",
        "sync-gmail-thread"
      ],
      "description": "Which write operation to perform — pass its matching params object below (e.g. action: \"update-fields\" pairs with updateFields: {...})."
    },
    "create": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name for the new conversation, e.g. the company or deal name."
        },
        "status": {
          "type": "string",
          "description": "Initial status value, e.g. \"Lead\", \"Active\", \"Closed Won\". Must match one of the status options configured in the AOP."
        },
        "aopId": {
          "type": "string",
          "format": "uuid",
          "description": "ID of the AOP (playbook) to assign to this conversation. Omit to use the default AOP. Use list-aops to list available AOPs."
        },
        "priority": {
          "type": "string",
          "description": "Priority level, e.g. \"High\", \"Medium\", \"Low\". Omit if not applicable."
        },
        "nextStep": {
          "type": "string",
          "description": "Initial next step or action item for this conversation."
        },
        "objective": {
          "type": "string",
          "description": "Goal or objective for this conversation."
        },
        "dealValue": {
          "type": "number",
          "description": "Deal value in the smallest currency unit (e.g. cents for USD)."
        },
        "participantEmails": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "email"
          },
          "description": "Email addresses of the main contacts to link to this conversation. If a single email is provided, that person is set as the main contact."
        },
        "companyDomains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Company domains to link to this conversation, e.g. [\"acme.com\"]. Use lookup-company-fuzzy to resolve the domain if you only know the company name."
        },
        "searchEmails": {
          "type": "boolean",
          "description": "When true, Cedar will search the user's inbox in the background for past threads involving the linked company domain and attach them to the new conversation. Requires companyDomain to be set."
        },
        "companyDomain": {
          "type": "string",
          "description": "Primary company domain hint used by searchEmails to find historical threads. Required when searchEmails is true."
        }
      },
      "required": [
        "name",
        "status"
      ],
      "additionalProperties": false
    },
    "updateFields": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid",
          "description": "Pass after get-conversation; omit only if the active UI conversation ID is in context."
        },
        "title": {
          "type": "string",
          "description": "Required chat approval title: e.g. \"Update deal size to $50K\" or \"Set status to Qualified\"."
        },
        "reasoning": {
          "type": "string",
          "description": "Required: evidence for each value, e.g. \"Email mentioned 600 students enrolled across both programs\"; omit only for a direct user request alone."
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Exact field name from get-conversation."
              },
              "mode": {
                "type": "string",
                "enum": [
                  "replace",
                  "patch",
                  "upsert",
                  "append",
                  "update"
                ],
                "description": "People: upsert value={people:[{id,...changes}]}; history: append complete new entries or update existing IDs in value={entries:[...]}. Omitted properties stay; arrays replace. New rows need all required data. replace=value only; patch=old_string+new_string only. Null/omitted never clears; \"\" clears."
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "people": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "name": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "title": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "email": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "format": "email"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "contactId": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "engagement": {
                                  "type": "string",
                                  "enum": [
                                    "mentioned",
                                    "introduced",
                                    "engaged",
                                    "should_engage"
                                  ]
                                },
                                "roles": {
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "support": {
                                  "type": "string",
                                  "enum": [
                                    "strong_support",
                                    "support",
                                    "neutral",
                                    "opposed",
                                    "unknown"
                                  ]
                                },
                                "summary": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "evidence": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "eventId": {
                                        "type": "string",
                                        "minLength": 1
                                      },
                                      "quote": {
                                        "type": "string",
                                        "minLength": 1
                                      }
                                    },
                                    "required": [
                                      "eventId",
                                      "quote"
                                    ],
                                    "additionalProperties": false
                                  }
                                }
                              },
                              "required": [
                                "id"
                              ],
                              "additionalProperties": false
                            },
                            "maxItems": 40
                          }
                        },
                        "required": [
                          "people"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "entries": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "title": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 120
                                },
                                "occurredAt": {
                                  "type": "string",
                                  "format": "date-time"
                                },
                                "kind": {
                                  "type": "string",
                                  "enum": [
                                    "meeting",
                                    "correspondence",
                                    "email",
                                    "milestone"
                                  ]
                                },
                                "summary": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 600
                                },
                                "sourceEventIds": {
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "minItems": 1
                                }
                              },
                              "required": [
                                "id"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "entries"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "stage": {
                                "type": "string",
                                "enum": [
                                  "discovery",
                                  "demo",
                                  "commercial",
                                  "negotiation"
                                ]
                              },
                              "rows": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "label": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "value": {
                                      "type": "string"
                                    },
                                    "graded": {
                                      "type": "boolean",
                                      "default": true
                                    },
                                    "signal": {
                                      "anyOf": [
                                        {
                                          "type": "string",
                                          "enum": [
                                            "green",
                                            "yellow",
                                            "red"
                                          ]
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ],
                                      "default": null
                                    },
                                    "signalReasoning": {
                                      "type": [
                                        "string",
                                        "null"
                                      ]
                                    },
                                    "strength": {
                                      "anyOf": [
                                        {
                                          "type": "integer",
                                          "minimum": 0,
                                          "maximum": 100
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    }
                                  },
                                  "required": [
                                    "label",
                                    "value"
                                  ],
                                  "additionalProperties": false
                                },
                                "maxItems": 3
                              },
                              "rubric": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "stage",
                              "rows"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "rows": {
                                "type": "array",
                                "items": {
                                  "$ref": "#/properties/updateFields/properties/fields/items/properties/value/anyOf/4/anyOf/2/anyOf/0/properties/rows/items"
                                }
                              }
                            },
                            "required": [
                              "rows"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    ]
                  }
                ],
                "description": "Scalar or native people/history/journey object, or JSON string. Preserve stable IDs. Omit for patches."
              },
              "old_string": {
                "type": "string",
                "description": "Exact substring appearing once in current value from get-conversation."
              },
              "new_string": {
                "type": "string",
                "description": "Patch replacement text; \"\" deletes old_string."
              },
              "signal": {
                "type": "string",
                "enum": [
                  "red",
                  "yellow",
                  "green"
                ],
                "description": "Set only when the field description instructs a signal; follow its red/yellow/green rubric."
              },
              "signalReasoning": {
                "type": "string",
                "description": "Brief explanation for the signal."
              },
              "reasoning": {
                "type": "string",
                "description": "Always provide one sentence linking this field value to event evidence (e.g. \"Tony confirmed department and dean support for the subscription\")."
              },
              "strength": {
                "type": "number",
                "description": "Owned type:list scorecard only (e.g. coaching.followup.rs1): 1–100 rating; value=verbatim evidence, reasoning=one-line justification. All three go on one event atom, never a persistent field. Omit otherwise."
              },
              "contextQuote": {
                "type": "string",
                "description": "Owned list scorecard full triple only: verbatim lead-in immediately before value. Never fabricate; omit for bare quotes."
              },
              "reactionQuote": {
                "type": "string",
                "description": "Owned list scorecard triple with contextQuote only: other party's verbatim reaction immediately after value; omit if absent."
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "description": "Only fields get-conversation marks writable=true; otherwise relay blockedReason. Omit/empty only when linking via linkCrmDeal."
        },
        "targetDealId": {
          "type": "string",
          "description": "Multiple linked CRM opportunities: Deal ID from <linked_crm_deal>; otherwise omit."
        },
        "linkCrmDeal": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "description": "The CRM provider identifier (e.g. \"hubspot\", \"salesforce\", \"attio\")"
            },
            "dealId": {
              "type": "string",
              "description": "The opportunity/deal ID returned by the CRM after creation"
            },
            "instanceUrl": {
              "type": "string",
              "description": "For Salesforce: the org Lightning base URL. For HubSpot: the portal hub_id (e.g. \"245934213\") — required to generate deep-link URLs."
            }
          },
          "required": [
            "provider",
            "dealId"
          ],
          "additionalProperties": false,
          "description": "Link a newly-created CRM deal/opportunity: save dealId in integration_metadata and close open crm-opportunity tasks. Runs before field updates so they sync to that deal."
        }
      },
      "additionalProperties": false
    },
    "createEvent": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid",
          "description": "ID of the conversation to add the event to. This is provided in the <conversation_id> section of your prompt."
        },
        "eventType": {
          "type": "string",
          "enum": [
            "meeting",
            "call",
            "text",
            "custom"
          ],
          "description": "Type of event: \"meeting\" for in-person or video meetings, \"call\" for phone calls, \"text\" for text/chat messages, \"custom\" for any other interaction."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Short descriptive title for the event, e.g. \"Intro call with John\""
        },
        "occurredAt": {
          "type": "string",
          "description": "ISO 8601 datetime when the event occurred, e.g. \"2026-03-20T14:00:00Z\". Use the current time if not specified."
        },
        "description": {
          "type": "string",
          "description": "Short description of the event."
        },
        "notes": {
          "type": "string",
          "description": "Personal notes about the event. For meetings stored as meeting.notes; for calls stored as call.notes."
        },
        "transcript": {
          "type": "string",
          "description": "Transcript or verbatim content. For meetings stored as meeting.aiNotes; for calls appended to call.notes."
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "email",
              "name"
            ],
            "additionalProperties": false
          },
          "description": "Participants in the event. Only relevant for meetings and calls."
        },
        "content": {
          "type": "string",
          "description": "The full text/message content. Only used when eventType is \"text\"."
        },
        "requirePaste": {
          "type": "boolean",
          "description": "Set to true whenever any transcript content is involved — even if the user already pasted it in the chat. ALWAYS use requirePaste instead of the transcript field. The frontend renders a textarea so the user pastes directly there. Do NOT pass transcript when requirePaste is true."
        }
      },
      "required": [
        "conversationId",
        "eventType",
        "title",
        "occurredAt"
      ],
      "additionalProperties": false
    },
    "mutate": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "ONE plain-English sentence describing what will happen — shown to the user in the approval card. No IDs, no technical terms."
        },
        "mutation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "move_event"
                },
                "eventId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "ID of any event in the thread to move"
                },
                "targetConversationId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Destination conversation ID — an EXISTING deal. Provide this OR newConversation, not both."
                },
                "newConversation": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Name for the new deal (defaults to the company domain, else \"New deal\")"
                    },
                    "companyDomain": {
                      "type": "string",
                      "description": "Domain of the deal's REAL counterparty (the company the deal is actually with), used to tie the company to the new deal. Supply this yourself from the event context — do NOT default to the sender's domain if the event was misrouted, since a wrong sender-domain is usually what caused the misrouting. Omit if genuinely unsure (the deal is created with no primary company)."
                    },
                    "aopId": {
                      "type": "string",
                      "description": "AOP to assign to the new deal; omit to let Cedar pick the best one from the event."
                    }
                  },
                  "additionalProperties": false,
                  "description": "Create a NEW deal and move the event onto it. Provide this OR targetConversationId, not both."
                }
              },
              "required": [
                "operation",
                "eventId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "reassign_aop"
                },
                "conversationId": {
                  "type": "string",
                  "format": "uuid"
                },
                "aopId": {
                  "type": "string",
                  "description": "ID of the AOP to assign"
                }
              },
              "required": [
                "operation",
                "conversationId",
                "aopId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "refresh_conversation"
                },
                "conversationId": {
                  "type": "string",
                  "format": "uuid"
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "reconcile",
                    "full"
                  ],
                  "default": "reconcile",
                  "description": "'reconcile' (default): re-derive fields + tasks from the events now on the deal — NO draft. 'full': re-run the whole on-event pipeline for one event (incl. drafting) to reproduce a missing output — requires eventId."
                },
                "eventId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Required for scope:'full' — the event whose on-event pipeline to re-run."
                }
              },
              "required": [
                "operation",
                "conversationId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "refresh_fields"
                },
                "conversationId": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "operation",
                "conversationId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "clear_working_memory"
                },
                "conversationId": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "operation",
                "conversationId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "merge_conversations"
                },
                "sourceConversationId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Conversation to merge FROM — all its events, tasks, and history will be moved into the target, then it will be deleted"
                },
                "targetConversationId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Conversation to merge INTO — this one survives"
                }
              },
              "required": [
                "operation",
                "sourceConversationId",
                "targetConversationId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "merge_companies"
                },
                "sourceCompanyId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Company to merge FROM — will be aliased to the target permanently"
                },
                "targetCompanyId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Company to merge INTO — the canonical company that survives"
                }
              },
              "required": [
                "operation",
                "sourceCompanyId",
                "targetCompanyId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "fix_misassignment"
                },
                "conversationId": {
                  "type": "string",
                  "format": "uuid"
                },
                "dryRun": {
                  "type": "boolean",
                  "default": true,
                  "description": "When true, previews what would change without applying"
                }
              },
              "required": [
                "operation",
                "conversationId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "assign_aop_by_selection"
                },
                "conversationId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Let Cedar's AI re-pick the best AOP from this conversation's email history"
                }
              },
              "required": [
                "operation",
                "conversationId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "rename_conversation"
                },
                "conversationId": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string",
                  "description": "New display name for the conversation"
                }
              },
              "required": [
                "operation",
                "conversationId",
                "name"
              ],
              "additionalProperties": false
            }
          ]
        },
        "conversationId": {
          "type": "string",
          "description": "Primary conversation ID for the card UI context (shown alongside description)."
        }
      },
      "required": [
        "description",
        "mutation"
      ],
      "additionalProperties": false
    },
    "reassignOwnership": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid",
          "description": "ID of the conversation to reassign ownership of."
        },
        "newOwnerUserId": {
          "type": "string",
          "description": "Cedar user ID of the org member who should become the new owner."
        }
      },
      "required": [
        "conversationId",
        "newOwnerUserId"
      ],
      "additionalProperties": false
    },
    "linkExternalCrmDeal": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid",
          "description": "The Cedar conversation to link — NOT the external CRM's own record id."
        },
        "providerId": {
          "type": "string",
          "enum": [
            "hubspot",
            "attio",
            "salesforce",
            "copper"
          ]
        },
        "dealId": {
          "type": "string",
          "minLength": 1,
          "description": "The external CRM's own deal/opportunity id — from search-external-crm-deals's result."
        }
      },
      "required": [
        "conversationId",
        "providerId",
        "dealId"
      ],
      "additionalProperties": false,
      "description": "Operates on the user's connected EXTERNAL CRM (Salesforce/HubSpot/Attio/Copper) — NOT Cedar's own conversation records (that's `find`). If it's unclear whether the user means \"search Cedar's deals\" or \"search our Salesforce/HubSpot\", ask before calling either."
    },
    "syncGmailThread": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid",
          "description": "The EXISTING Cedar deal to pull the email into."
        },
        "threadId": {
          "type": "string",
          "description": "Exact Gmail thread id, if you already have it. Provide this OR searchQuery."
        },
        "searchQuery": {
          "type": "string",
          "description": "A Gmail search string (full Gmail syntax, e.g. \"from:jane@acme.com subject:intro after:2026/01/01\") to find the thread when you do not have its id. If several threads match, the tool returns them as candidates for you to disambiguate rather than guessing. Provide this OR threadId."
        }
      },
      "required": [
        "conversationId"
      ],
      "additionalProperties": false,
      "description": "Search the user's LIVE Gmail for an email that never synced into Cedar and pull it into an existing deal, where it processes like a normal inbound (draft included). Use this only AFTER find-event confirms the email is not in Cedar at all — it is the \"bring it in from the mailbox\" repair."
    },
    "user_request_summary": {
      "type": "string",
      "description": "One sentence, in your own words: what the user actually asked you to do in this turn. Used only for Cedar's observability — it does not change what this tool does."
    },
    "is_new_request": {
      "type": "boolean",
      "description": "true on the FIRST Cedar tool call of a NEW user request; false when this call continues the same request you are already working on. Groups related calls into one activity thread."
    }
  },
  "required": [
    "action",
    "user_request_summary",
    "is_new_request"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
