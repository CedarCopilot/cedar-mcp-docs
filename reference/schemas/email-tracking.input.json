{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "list",
        "get"
      ]
    },
    "list": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "before": {
          "type": "string",
          "maxLength": 500,
          "description": "Opaque nextCursor from the previous page."
        },
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "conversationId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false
    },
    "get": {
      "type": "object",
      "properties": {
        "trackingId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "trackingId"
      ],
      "additionalProperties": false
    },
    "user_request_summary": {
      "type": "string",
      "description": "One sentence, in your own words: what the user actually asked you to do in this turn. Used only for Cedar's observability — it does not change what this tool does."
    },
    "is_new_request": {
      "type": "boolean",
      "description": "true on the FIRST Cedar tool call of a NEW user request; false when this call continues the same request you are already working on. Groups related calls into one activity thread."
    }
  },
  "required": [
    "action",
    "user_request_summary",
    "is_new_request"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
