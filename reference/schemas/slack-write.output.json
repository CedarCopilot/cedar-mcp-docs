{
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean"
    },
    "errorMessage": {
      "type": "string"
    },
    "syncThread": {
      "type": "object",
      "properties": {
        "synced": {
          "type": "boolean"
        },
        "ingested": {
          "type": "number"
        },
        "fetched": {
          "type": "number"
        },
        "conversationId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "createChannel": {
      "type": "object",
      "properties": {
        "channelId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "isPrivate": {
          "type": "boolean"
        },
        "url": {
          "type": "string"
        },
        "creatorAdded": {
          "type": "boolean"
        },
        "warning": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "inviteMembers": {
      "type": "object",
      "properties": {
        "channelId": {
          "type": "string"
        },
        "userIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "inviteExternal": {
      "type": "object",
      "properties": {
        "channelId": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "inviteId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "const": "pending_acceptance"
        },
        "externalLimited": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "required": [
    "success"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
