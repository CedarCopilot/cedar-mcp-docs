{
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "ONE plain-English sentence describing the change — the only thing the user will see. No IDs, no technical terms."
    },
    "change": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "update_user_settings"
            },
            "slackNotifications": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "digestTimezone": {
                  "type": "string",
                  "description": "IANA timezone, e.g. \"America/New_York\""
                },
                "deliveryMethod": {
                  "type": "string",
                  "enum": [
                    "dm",
                    "channel"
                  ]
                }
              },
              "additionalProperties": false,
              "description": "Slack notification preferences. Merged with existing values — omit fields to leave unchanged."
            },
            "emailNotifications": {
              "type": "object",
              "additionalProperties": {},
              "description": "Email notification preferences (e.g. {enabled, agendaEmail}). Sub-keys merge individually — omit a sub-key to leave it unchanged."
            },
            "imessageNotifications": {
              "type": "object",
              "additionalProperties": {},
              "description": "iMessage notification preferences. Sub-keys merge individually — omit a sub-key to leave it unchanged."
            },
            "whatsappNotifications": {
              "type": "object",
              "additionalProperties": {},
              "description": "WhatsApp notification preferences. Sub-keys merge individually — omit a sub-key to leave it unchanged."
            },
            "signatureEnabled": {
              "type": "boolean",
              "description": "Whether the email signature is active."
            },
            "signatureContent": {
              "type": "string",
              "description": "HTML or plain-text signature block."
            },
            "defaultEmailAlias": {
              "type": "string",
              "description": "Default from-address alias for composed emails."
            },
            "undoSendEnabled": {
              "type": "boolean",
              "description": "Whether undo-send is enabled."
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "update_inbox_settings"
            },
            "linkedinNavigation": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "maxItems": 200
                },
                "hidden": {
                  "type": "array",
                  "items": {
                    "$ref": "#/properties/change/anyOf/1/properties/linkedinNavigation/properties/order/items"
                  },
                  "maxItems": 200
                },
                "filters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "view": {
                        "type": "string",
                        "enum": [
                          "all",
                          "focused",
                          "archive",
                          "reminders",
                          "drafts",
                          "unread",
                          "starred",
                          "inmail",
                          "salesnav",
                          "spam",
                          "sponsored",
                          "other"
                        ]
                      },
                      "filter": {
                        "type": "string",
                        "enum": [
                          "all",
                          "waiting-them",
                          "waiting-me",
                          "unread"
                        ]
                      },
                      "search": {
                        "type": "string",
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "id",
                      "name",
                      "view",
                      "filter"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 100
                }
              },
              "required": [
                "order",
                "hidden"
              ],
              "additionalProperties": false,
              "description": "LinkedIn sections, order, visibility and saved filters. Read inboxes settings first. Label IDs use label:<uuid>; saved views use filter:<id>."
            },
            "inboxSortingInstructions": {
              "type": "string",
              "maxLength": 20000,
              "description": "Shared Gmail/LinkedIn/Slack attention-label preferences. Replaces the current text; read-settings sections:[\"inboxes\"] first. Empty text clears. Maximum 20,000 characters. Does not enable sending or CRM admission."
            },
            "inboxLayout": {
              "type": "string",
              "enum": [
                "inbox",
                "important_other",
                "stacked"
              ],
              "description": "Global inbox layout mode."
            },
            "importantSignal": {
              "type": "string",
              "enum": [
                "category_personal",
                "gmail_important"
              ],
              "description": "Which signal marks a thread \"important\"."
            },
            "inboxOrder": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Ordered inbox/tab ids, left to right. Get current ids from read-settings sections:[\"inboxes\"]."
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "manage_inbox"
            },
            "op": {
              "type": "string",
              "enum": [
                "create",
                "update",
                "delete",
                "reorder"
              ],
              "description": "create/update/delete/reorder a custom inbox tab (split). accountId is resolved server-side."
            },
            "inboxId": {
              "type": "string",
              "description": "Required for update/delete. From read-settings sections:[\"inboxes\"]."
            },
            "name": {
              "type": "string",
              "description": "Required for create; the tab label."
            },
            "rule": {
              "description": "Structured inbox rule: {kind:\"all\"} | {kind:\"all_of\"|\"any_of\", clauses:[...]}. Validated server-side against inboxRuleSchema; read-settings sections:[\"inboxes\"] shows real examples."
            },
            "query": {
              "type": "string",
              "description": "Gmail query string for this tab."
            },
            "excludeQuery": {
              "type": "string",
              "description": "Gmail query whose matches are subtracted; empty string clears it."
            },
            "lookbackDays": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "const": "all"
                }
              ],
              "description": "How far back to scan."
            },
            "alsoShowInImportant": {
              "type": "boolean"
            },
            "hideWhenEmpty": {
              "type": "boolean"
            },
            "position": {
              "type": "integer",
              "description": "Tab position; omit to append."
            },
            "conversationFilter": {
              "description": "CRM rule restricting this tab to matching linked conversations, shaped {filters:{...}, uiConfig?:{...}}; null clears it. Copy the shape from an existing inbox via read-settings sections:[\"inboxes\"] — validated server-side against inboxConversationFilterSchema."
            },
            "channels": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "email",
                  "linkedin",
                  "whatsapp",
                  "slack"
                ]
              },
              "description": "Channels this tab evaluates; defaults to email only."
            },
            "orderedInboxIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Required for reorder: every inbox id in the new order."
            }
          },
          "required": [
            "type",
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "manage_task_group"
            },
            "op": {
              "type": "string",
              "enum": [
                "create",
                "update",
                "delete",
                "reorder"
              ],
              "description": "create/update/delete/reorder a task group (the lanes tasks are filed into)."
            },
            "groupId": {
              "type": "string",
              "description": "Required for update/delete. From read-settings sections:[\"task_groups\"]."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Required for create; the group name."
            },
            "color": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ],
              "description": "UI accent (hex or token)."
            },
            "icon": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ],
              "description": "Lucide icon name (e.g. \"Trophy\")."
            },
            "routingCriteria": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ],
              "description": "Natural-language description the AI router reads to file tasks here; null = never auto-file."
            },
            "agentVisible": {
              "type": "boolean",
              "description": "Whether the agent sees this group in its default task list."
            },
            "overduePolicy": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "nag",
                        "auto-complete",
                        "ignore"
                      ]
                    },
                    "afterDays": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "agentMayReschedule": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "mode",
                    "afterDays",
                    "agentMayReschedule"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "description": "How overdue tasks in this group are handled; null = default nag behavior."
            },
            "position": {
              "type": "integer",
              "description": "Display order; omit to append."
            },
            "orderedGroupIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Required for reorder: every group id in the new order."
            }
          },
          "required": [
            "type",
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "update_webhook_export_config"
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ],
              "description": "HTTPS endpoint Cedar POSTs conversation-field updates to on every change. Pass null to clear."
            },
            "secret": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "not": {}
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Shared secret so the endpoint can verify a request genuinely came from Cedar. Omit to keep the existing one."
            },
            "secretHeader": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "not": {}
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Header name carrying the secret. Defaults \"X-Cedar-Secret\"."
            }
          },
          "required": [
            "type",
            "url"
          ],
          "additionalProperties": false
        }
      ]
    },
    "targetUserId": {
      "type": "string",
      "description": "Apply the change to ANOTHER user in your organization instead of yourself. Omit for your own settings, which is almost always what you want."
    },
    "user_request_summary": {
      "type": "string",
      "description": "One sentence, in your own words: what the user actually asked you to do in this turn. Used only for Cedar's observability — it does not change what this tool does."
    },
    "is_new_request": {
      "type": "boolean",
      "description": "true on the FIRST Cedar tool call of a NEW user request; false when this call continues the same request you are already working on. Groups related calls into one activity thread."
    }
  },
  "required": [
    "description",
    "change",
    "user_request_summary",
    "is_new_request"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
