{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "initialize",
        "get-kpis",
        "get-pipeline-kpis"
      ]
    },
    "initialize": {
      "type": "object",
      "properties": {
        "templateId": {
          "type": "string",
          "minLength": 1
        },
        "targetUserId": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        }
      },
      "required": [
        "templateId"
      ],
      "additionalProperties": false
    },
    "getPipelineKpis": {
      "type": "object",
      "properties": {
        "targetUserId": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "getKpis": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string",
          "minLength": 1
        },
        "targetUserId": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "format": "date-time",
          "description": "Full ISO timestamp with Z or a timezone offset."
        },
        "to": {
          "type": "string",
          "format": "date-time",
          "description": "Full ISO timestamp with Z or a timezone offset."
        }
      },
      "required": [
        "agentId",
        "from",
        "to"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "action"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
