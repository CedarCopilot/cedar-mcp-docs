{
  "type": "object",
  "properties": {
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "producerKey": {
      "$ref": "#/properties/accountId"
    },
    "operationId": {
      "$ref": "#/properties/accountId"
    },
    "state": {
      "type": "string",
      "enum": [
        "awaiting_evidence",
        "pending",
        "leased",
        "delivered",
        "superseded",
        "blocked"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 25
    },
    "before": {
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "id": {
          "$ref": "#/properties/accountId"
        }
      },
      "required": [
        "createdAt",
        "id"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "string",
      "enum": [
        "producers",
        "list"
      ]
    },
    "user_request_summary": {
      "type": "string",
      "description": "One sentence, in your own words: what the user actually asked you to do in this turn. Used only for Cedar's observability — it does not change what this tool does."
    },
    "is_new_request": {
      "type": "boolean",
      "description": "true on the FIRST Cedar tool call of a NEW user request; false when this call continues the same request you are already working on. Groups related calls into one activity thread."
    }
  },
  "required": [
    "accountId",
    "action",
    "user_request_summary",
    "is_new_request"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
