{
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "trackingId": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "threadId": {
            "type": [
              "string",
              "null"
            ]
          },
          "gmailMessageId": {
            "type": [
              "string",
              "null"
            ]
          },
          "toEmails": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recipientEmail": {
            "type": [
              "string",
              "null"
            ]
          },
          "attribution": {
            "type": "string",
            "enum": [
              "single_recipient",
              "unattributed"
            ]
          },
          "attributionNote": {
            "type": "string"
          },
          "sentAt": {
            "type": "string"
          },
          "openCount": {
            "type": "number"
          },
          "clickCount": {
            "type": "number"
          },
          "rawOpenCount": {
            "type": "number"
          },
          "rawClickCount": {
            "type": "number"
          },
          "unknownOpenCount": {
            "type": "number"
          },
          "automatedOpenCount": {
            "type": "number"
          },
          "firstOpenedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastOpenedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "firstClickedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "openTrackingEnabled": {
            "type": "boolean"
          },
          "linkTrackingEnabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "trackingId",
          "subject",
          "threadId",
          "gmailMessageId",
          "toEmails",
          "recipientEmail",
          "attribution",
          "attributionNote",
          "sentAt",
          "openCount",
          "clickCount",
          "rawOpenCount",
          "rawClickCount",
          "unknownOpenCount",
          "automatedOpenCount",
          "firstOpenedAt",
          "lastOpenedAt",
          "firstClickedAt",
          "openTrackingEnabled",
          "linkTrackingEnabled"
        ],
        "additionalProperties": false
      }
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "record": {
      "anyOf": [
        {
          "$ref": "#/properties/records/items"
        },
        {
          "type": "null"
        }
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "eventType": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string"
          },
          "clientType": {
            "type": [
              "string",
              "null"
            ]
          },
          "isReliable": {
            "type": "boolean"
          },
          "linkUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "assessment": {
            "type": "object",
            "properties": {
              "version": {
                "type": "number",
                "const": 3
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "likely_human",
                  "automated",
                  "unknown"
                ]
              },
              "reason": {
                "type": "string"
              },
              "clientType": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "enum": [
                  "gmail_prefetch",
                  "gmail_proxy",
                  "known_scanner",
                  "privacy_proxy",
                  "image_proxy",
                  "direct_client",
                  "unrecognized"
                ]
              },
              "activity": {
                "type": "string",
                "enum": [
                  "likely_render",
                  "likely_interaction",
                  "automated_fetch",
                  "unknown"
                ]
              },
              "attribution": {
                "type": "string",
                "const": "message"
              },
              "viewerIdentity": {
                "type": "string",
                "const": "unknown"
              },
              "selfActivity": {
                "type": "string",
                "enum": [
                  "possible",
                  "no_specific_evidence"
                ]
              },
              "reasonCodes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "number",
                    "const": 1
                  },
                  "origin": {
                    "type": "string",
                    "enum": [
                      "request",
                      "legacy_assessment",
                      "legacy_user_agent"
                    ]
                  },
                  "method": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 32
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "purpose": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 256
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "secPurpose": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 256
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "senderIpMatch": {
                    "type": "boolean"
                  },
                  "elapsedSinceSendMs": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "headersTruncated": {
                    "type": "boolean"
                  },
                  "eventType": {
                    "type": "string",
                    "enum": [
                      "opened",
                      "clicked"
                    ]
                  }
                },
                "required": [
                  "version",
                  "origin",
                  "method",
                  "purpose",
                  "secPurpose",
                  "senderIpMatch",
                  "elapsedSinceSendMs",
                  "headersTruncated",
                  "eventType"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "version",
              "verdict",
              "reason",
              "clientType",
              "source",
              "activity",
              "attribution",
              "viewerIdentity",
              "selfActivity",
              "reasonCodes",
              "evidence"
            ],
            "additionalProperties": false
          },
          "originalAssessment": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "eventType",
          "occurredAt",
          "clientType",
          "isReliable",
          "linkUrl",
          "assessment"
        ],
        "additionalProperties": false
      }
    },
    "errorMessage": {
      "type": "string"
    }
  },
  "required": [
    "success"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
