              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "query"
        ],
        "additionalProperties": false
      }
    },
    "itemCount": {
      "type": "number"
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canvas": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "homeViewOrder": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "type",
        "homeViewOrder"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "success"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
